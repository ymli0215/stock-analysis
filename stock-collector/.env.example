# === Database（mysql84 / stockapp）===
DB_HOST=mysql84
DB_PORT=3306
DB_NAME=stockapp
DB_USER=root
DB_PASSWORD=changeme

# === Telegram（bot A：webhook /stockinfo 那隻，stocks_raw_data 的 file_id 綁定此 bot）===
TELEGRAM_BOT_TOKEN=123456:xxxx
# 群組通知用 bot（需為 NOTIFY_GROUP_CHAT_ID 群組成員；未設定時退回 TELEGRAM_BOT_TOKEN）
TELEGRAM_NOTIFY_BOT_TOKEN=123456:xxxx

# === Jobs（部署時先全關，切換 n8n flow 停用後才打開，避免雙跑）===
STOCK_COLLECT_ENABLED=false
STOCK_COLLECT_CHAT_ID=2130788733
STOCK_COLLECT_INTERVAL_SECONDS=120
SYNC_STOCK_DATA_ENABLED=false
IMPORT_WARRANT_ENABLED=false

# === StockServer（走 dev_master_network 內部連線）===
STOCKSERVER_BASE=http://stock:8080/StockServer
NOTIFY_GROUP_CHAT_ID=-4921060460

# === Obsidian ===
OBSIDIAN_ROOT=/obsidian

# === claude CLI 認證（沿用 claude-agent 容器的 gateway 設定）===
ANTHROPIC_AUTH_TOKEN=sk-xxxx
ANTHROPIC_BASE_URL=https://example.com
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_SECONDS=900
